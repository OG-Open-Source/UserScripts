# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Keep Windows scripts in CRLF if any exist
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly mark common binary assets to prevent accidental corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary
*.zip binary
*.tar.gz binary
