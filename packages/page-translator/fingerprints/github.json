{
  "id": "github",
  "version": 1,
  "detectSelectors": [
    "meta[name='hostname'][content='github.com']",
    "meta[name='apple-itunes-app'][content*='GitHub']",
    "body[data-turbo-body]"
  ],
  "regions": {
    "topbar": ["header.AppHeader", "header.Header"],
    "sidebar": [".Layout-sidebar"],
    "content": ["main", "#repo-content-turbo-frame"],
    "footer": ["footer"],
    "nav": ["nav[aria-label='Repository']"],
    "insights": ["nav[aria-label='Insights']"],
    "markdownBody": [".markdown-body"]
  },
  "captureSelectors": [
    "main",
    "#repo-content-turbo-frame",
    "main .markdown-body",
    "main .js-comment-body",
    ".markdown-body",
    ".js-comment-body",
    ".Subhead",
    "#repository-container-header",
    "nav[aria-label='Repository']",
    "nav[aria-label='Insights']"
  ],
  "excludeSelectors": [
    "header.AppHeader",
    "header.Header",
    "footer",
    "code",
    "pre"
  ],
  "spaRescanSelectors": ["main", "#repo-content-turbo-frame", ".markdown-body"],
  "policies": {
    "nav": "menu",
    "button": "button",
    ".Subhead": "title",
    ".Counter": "badge",
    ".markdown-body": "prose"
  }
}
